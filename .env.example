APP_NAME=WhyHouse Backend
APP_ENV=local
APP_VERSION=0.1.0
LOG_LEVEL=INFO

API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Supabase / Postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://whyhouse:whyhouse@database:5432/whyhouse

# Local Docker database
POSTGRES_DB=whyhouse
POSTGRES_USER=whyhouse
POSTGRES_PASSWORD=whyhouse
POSTGRES_PORT=5432

# Naver Maps
VITE_NAVER_MAPS_CLIENT_ID=
VITE_NAVER_MAPS_DEFAULT_STYLE_ID=
VITE_NAVER_MAPS_TRANSIT_STYLE_ID=
VITE_NAVER_MAPS_SOFT_STYLE_ID=
VITE_NAVER_MAPS_NO_TRANSIT_STYLE_ID=

# Backend-only Naver API secret
NAVER_MAPS_CLIENT_SECRET=
NAVER_MAPS_GEOCODE_BASE_URL=https://maps.apigw.ntruss.com/map-geocode/v2
NAVER_MAPS_REVERSE_GEOCODE_BASE_URL=https://maps.apigw.ntruss.com/map-reversegeocode/v2

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
FRONTEND_COMMAND=npm run dev
VITE_APP_NAME=WhyHouse Front
VITE_API_BASE_URL=http://localhost:8000
