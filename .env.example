APP_NAME=WhyHouse Backend
APP_ENV=local
APP_VERSION=0.1.0
LOG_LEVEL=INFO

API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase / Postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://whyhouse:whyhouse@database:5432/whyhouse

# Local Docker database
POSTGRES_DB=whyhouse
POSTGRES_USER=whyhouse
POSTGRES_PASSWORD=whyhouse
POSTGRES_PORT=5432

# Naver Maps API
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=
NAVER_MAPS_GEOCODE_BASE_URL=https://naveropenapi.apigw.ntruss.com/map-geocode/v2

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
FRONTEND_CONTEXT=../WhyHouse_Front
FRONTEND_COMMAND=npm run dev -- --host 0.0.0.0
